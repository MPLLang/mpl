local
  $(SML_LIB)/basis/basis.mlb
  $(SML_LIB)/basis/mlton.mlb
  $(SML_LIB)/basis/mpl.mlb
  $(SML_LIB)/basis/unsafe.mlb

  local
    $(SML_LIB)/basis/build/sources.mlb
  in
    signature ARRAY_EXTRA
    signature ARRAY_SLICE_EXTRA
    structure ArrayExtra = Array
    structure ArraySliceExtra = ArraySlice
    structure Primitive
    structure MLtonFFI

    functor Int_ChooseFromInt
    functor Int_ChooseInt
    functor Word_ChooseWordN
  end

  CumulativePerProcTimer.sml
  SimpleRandom.sml
  ann
    "allowFFI true"
    "allowPrim true"
  in
    DequeABP.sml
  end
  Result.sml
  
  ann
     "exnDecElab app"
  in
    Universal.sml
  end

  ann
    "allowFFI true"
    "allowPrim true"
  in
    Heartbeat.sml
    Scheduler.sml
  end
  ForkJoin.sml
in
  structure ForkJoin
end
