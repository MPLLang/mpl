local
  $(SML_LIB)/basis/basis.mlb
  $(SML_LIB)/basis/mlton.mlb
  $(SML_LIB)/basis/mpl.mlb
  $(SML_LIB)/basis/unsafe.mlb

  local
    $(SML_LIB)/basis/build/sources.mlb
  in
    signature ARRAY_EXTRA
    signature ARRAY_SLICE_EXTRA
    signature ARRAY_AOS_EXTRA
    signature ARRAY_AOS_SLICE_EXTRA
    structure ArrayExtra = Array
    structure ArraySliceExtra = ArraySlice
    structure ArrayAosExtra = ArrayAos
    structure ArrayAosSliceExtra = ArrayAosSlice
    structure Primitive

    functor Int_ChooseFromInt
  end

  CumulativePerProcTimer.sml
  SimpleRandom.sml
  ann
    "allowFFI true"
    "allowPrim true"
  in
    DequeABP.sml
  end
  Result.sml
  
  ann
     "exnDecElab app"
  in
    Universal.sml
  end

  ann
    "allowFFI true"
    "allowPrim true"
  in
    Heartbeat.sml
    Scheduler.sml
  end
  ForkJoin.sml
in
  structure ForkJoin
end
